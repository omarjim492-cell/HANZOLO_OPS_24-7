rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function role() {
      return userDoc().role;
    }

    function department() {
      return userDoc().departmentId;
    }

    function isActive() {
      return signedIn() && userDoc().active == true;
    }

    function isSuperAdmin() {
      return isActive() && role() == 'superadmin';
    }

    function isAdmin() {
      return isActive() && (role() == 'admin' || role() == 'superadmin');
    }

    function isDirector() {
      return isActive() && role() == 'director';
    }

    function isFinance() {
      return isActive() && (
        role() == 'finance_manager' ||
        role() == 'finance_user' ||
        department() == 'finance'
      );
    }

    function isDepartmentMember(dept) {
      return isActive() && department() == dept;
    }

    function canManageUsers() {
      return isSuperAdmin() || isAdmin();
    }

    function canReadProject() {
      return isActive();
    }

    function canManageProject() {
      return isSuperAdmin() || isAdmin() || isDirector() ||
        isDepartmentMember('project_management') ||
        isDepartmentMember('technical');
    }

    function canReadFinance() {
      return isFinance() || isSuperAdmin() || isAdmin() || isDirector();
    }

    function canWriteFinance() {
      return isFinance() || isSuperAdmin() || isAdmin();
    }

    // User profile: users may read their own profile.
    // Administrative writes are restricted.
    match /users/{uid} {
      allow read: if isActive() && (request.auth.uid == uid || canManageUsers() || isDirector());
      allow create: if canManageUsers();
      allow update: if canManageUsers() || (
        isActive() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.departmentId == resource.data.departmentId
      );
      allow delete: if isSuperAdmin();
    }

    match /departments/{id} {
      allow read: if isActive();
      allow write: if canManageUsers();
    }

    match /roles/{id} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    match /projects/{id} {
      allow read: if canReadProject();
      allow create, update: if canManageProject();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /operations/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /technical_interventions/{id} {
      allow read: if isActive();
      allow create, update: if isActive() &&
        (department() == 'technical' ||
         department() == 'electrical_security' ||
         isAdmin() || isDirector());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /commercial_proposals/{id} {
      allow read: if isActive() &&
        (department() == 'commercial' || isAdmin() || isDirector());
      allow create, update: if isActive() &&
        (department() == 'commercial' || isAdmin());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // FINANCE: deliberately isolated from ordinary department users.
    match /financial_records/{id} {
      allow read: if canReadFinance();
      allow create, update: if canWriteFinance();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /documents/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /notifications/{id} {
      allow read: if isActive() &&
        resource.data.recipientUid == request.auth.uid;
      allow update: if isActive() &&
        resource.data.recipientUid == request.auth.uid;
      allow create: if isActive();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // Audit logs are append-only for normal users.
    match /audit_logs/{id} {
      allow read: if isSuperAdmin() || isAdmin() || isDirector();
      allow create: if isActive();
      allow update, delete: if isSuperAdmin();
    }

    // Deny everything not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
